#, python-format
msgid ""
"Dear %(user_name)s, You have been invited to %(site_title)s. A user has "
"already been created for you with the username %(user_name)s. You can change "
"it later. You have been added to the %(group_type)s %(group_title)s with the "
"following role: %(role_name)s. To accept this invite, please reset your "
"password at: %(reset_link)s Have a nice day. -- Message sent by "
"%(site_title)s (%(site_url)s)"
msgstr ""
"Уважаеми/а %(user_name)s, Поканени сте в %(site_title)s. За Вас вече е "
"създаден потребител с потребителско име %(user_name)s. Можете да го промените"
" по-късно. Добавени сте към %(group_type)s %(group_title)s със следната роля:"
" %(role_name)s. За да приемете поканата, моля, задайте нова парола на: "
"%(reset_link)s Приятен ден. -- Съобщение, изпратено от %(site_title)s "
"(%(site_url)s)"

#, python-format
msgid "Invite for %(site_title)s"
msgstr "Покана за %(site_title)s"

